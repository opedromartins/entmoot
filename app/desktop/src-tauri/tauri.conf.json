{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "entmoot",
  "version": "0.0.1",
  "identifier": "entmoot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "entmoot", "width": 1100, "height": 720, "minWidth": 400, "minHeight": 480, "visible": false, "decorations": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": { "installerIcon": "icons/icon.ico", "template": "windows/installer.nsi", "languages": ["PortugueseBR", "English"] }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
